{
  "name": "orbit-windows",
  "version": "1.0.0",
  "description": "Orbit Windows desk companion (H1-a1): idle presence, full-monitor capture, propose→Confirm, text-only act",
  "main": "main.js",
  "author": "Sean McCarron",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.seanmccarron.orbit-windows",
    "productName": "Orbit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "artifactName": "Orbit-${version}-${os}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
